# Application Environment Configuration
APP_ENV=development
APP_NAME=EVIDA
APP_VERSION=0.1.0

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Supabase Server-Side Configuration (PostgreSQL, Auth, RLS)
# SUPABASE_URL: Project URL from Supabase dashboard or local CLI
SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY: Client-safe anonymous key (optional on backend)
SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_ROLE_KEY: Backend-only administrative key. NEVER expose to frontend.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Nebius Token Factory & NVIDIA Model Configuration
# Obtain key from Nebius Token Factory / Nebius AI Cloud console
NEBIUS_API_KEY=your-nebius-token-factory-api-key
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# NVIDIA Open Model Identifier (e.g. nvidia/Nemotron-3_5-Lightning or custom Nebius catalog model)
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning

# Next.js Frontend Public Configuration (Browser-accessible)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_API_URL=http://localhost:8000
